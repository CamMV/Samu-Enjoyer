# Copiar como .env en la raíz del repo y ajustar a la máquina. El .env no se versiona.

# Servidor LOCAL del LLM (llama.cpp / vLLM / Ollama con API compatible con OpenAI). Nunca un SaaS.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
# Segundos por llamada; en CPU leer 10 pasajes toma minutos.
LLM_TIMEOUT=300

# El juez usa por defecto el mismo modelo y servidor del escritor.
# JUDGE_MODEL=
# JUDGE_BASE_URL=
# JUDGE_TIMEOUT=300

# Dónde se embebe la consulta de búsqueda. En GPUs de 4 GB (portátil) poner "cpu": embedder y
# reranker juntos no caben y la búsqueda pasa de 6 s a 60 s. Vacío = los dos en la GPU (A40).
RAG_DEVICE_DENSO=
