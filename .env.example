# Copiar como .env en la raíz del repo y ajustar a la máquina. El .env no se versiona.

# Servidor LOCAL del LLM (llama.cpp / vLLM / Ollama con API compatible con OpenAI). Nunca un SaaS.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
# Segundos por llamada; en CPU leer 10 pasajes toma minutos.
LLM_TIMEOUT=300

# El juez es un modelo distinto del escritor y necesita su propio servidor (llama.cpp ignora el
# campo "model": con la URL del escritor juzgaría el mismo Qwen).
JUDGE_MODEL=gemma4:e4b
JUDGE_BASE_URL=http://localhost:11434/v1
# Cerradas: 1 = el juez vota a ciegas y se compara su letra con la del escritor; si discrepan se busca
# de nuevo y, si persiste, queda la respuesta del escritor. 0 = el juez revisa el borrador como en el resto.
JUDGE_VOTO_CERRADAS=1
# JUDGE_TIMEOUT=300

# Dónde se embebe la consulta de búsqueda. En GPUs de 4 GB (portátil) poner "cpu": embedder y
# reranker juntos no caben y la búsqueda pasa de 6 s a 60 s. Vacío = los dos en la GPU (A40).
RAG_DEVICE_DENSO=

# Subagente de citas: 1 = además de suprimir las citas fuera de los pasajes, agregar el pasaje de las
# que existen en el corpus. Apagado (decisión del 1/oct): ver CLAUDE.md, sección 2.
CITAS_AGREGAR_PASAJES=0

# Caracteres para los 10 pasajes dentro del prompt del LLM (con -c 32768). Los que caben van completos.
MAX_CHARS_PASAJES=85000
