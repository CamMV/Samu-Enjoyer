# Copiar como .env (no se versiona). Vite lee estas variables al arrancar `npm run dev`.

# 1 = modo demo: respuestas, pasajes y documento de ejemplo, sin back.
# 0 = pide al back local (python -m src.api.server, desde la raíz del repo).
VITE_USE_MOCK=1

# Dirección del back local al que Vite reenvía /api (solo con VITE_USE_MOCK=0).
VITE_BACK_URL=http://127.0.0.1:8000
